# pocket-bot (see bot/README.md). Never commit real values.
TELEGRAM_BOT_TOKEN=
BOT_SERVICE_TOKEN=
API_BASE_URL=http://api:8000/api/v1
# Telegram user ids the bot answers, comma-separated (yours: ask @userinfobot). Empty = nobody.
TELEGRAM_ALLOWED_IDS=
# Public https address of the web app ("open in app" buttons). Empty = no link buttons.
PUBLIC_URL=https://pocket.example.com
TIMEZONE=Asia/Ho_Chi_Minh
OUTBOX_POLL_SECONDS=5
LOG_LEVEL=INFO
