{
  "version": 1,
  "disable_existing_loggers": false,
  "formatters": {
    "json": {"()": "pf_logging.JsonFormatter"},
    "access": {"()": "pf_logging.AccessJsonFormatter"}
  },
  "filters": {
    "no_healthcheck": {"()": "pf_logging.HealthcheckFilter"}
  },
  "handlers": {
    "default": {"class": "logging.StreamHandler", "formatter": "json", "stream": "ext://sys.stdout"},
    "access": {
      "class": "logging.StreamHandler",
      "formatter": "access",
      "filters": ["no_healthcheck"],
      "stream": "ext://sys.stdout"
    }
  },
  "loggers": {
    "uvicorn": {"handlers": ["default"], "level": "INFO", "propagate": false},
    "uvicorn.error": {"level": "INFO"},
    "uvicorn.access": {"handlers": ["access"], "level": "INFO", "propagate": false}
  },
  "root": {"handlers": ["default"], "level": "INFO"}
}
