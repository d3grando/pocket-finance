# Pocket Finance — переменные окружения (контракт — docs/ARCH.md §11).
# Скопируйте в .env:  scripts/gen-secrets.sh   (создаст .env и заполнит секреты)
# Секреты задаются ТОЛЬКО здесь (в .env), в образы и в git они не попадают.
# Пустое значение = значение по умолчанию из docker-compose.yml / приложения.

# ───────────── Общее ─────────────
# Имя compose-проекта (префикс контейнеров/томов). Не меняйте после установки — потеряете тома.
COMPOSE_PROJECT_NAME=pocket
# Версия (тег образов и поле version в /api/v1/health). scripts/update.sh ставит git describe.
PF_VERSION=1.0.0
# dev | test | prod. В prod приложение не стартует без SECRET_KEY/BOT_SERVICE_TOKEN, https-адреса
# в PUBLIC_URL и настроек AI (или AI_ENABLED=false).
APP_ENV=prod
LOG_LEVEL=INFO

# ───────────── Публикация ─────────────
# ОБЯЗАТЕЛЬНО: публичный https-адрес сайта (ссылки в боте, домен для Face ID / passkeys).
# Например https://pocket.example.com. Пусто — docker compose не запустится.
PUBLIC_URL=
# Дополнительные origin'ы веба через запятую (обычно пусто: origin из PUBLIC_URL разрешён всегда).
# Для пробы через SSH-туннель / localhost: http://127.0.0.1:8080. Electron-origin задаётся отдельно.
WEB_ORIGINS=
DESKTOP_ORIGIN=app://pocket
# Единственный опубликованный порт стека — контейнер web (статика + /api).
# 127.0.0.1 — только локально (reverse-proxy на этом же хосте). Если прокси на другой машине —
# 0.0.0.0 или конкретный IP, и закройте порт от остальной сети файрволом.
PF_HTTP_BIND=127.0.0.1
PF_HTTP_PORT=8080
# Чьему X-Forwarded-For верит контейнер web на опубликованном порту (Caddy trusted_proxies +
# strict: заголовок читается справа налево). CIDR через пробел, например 192.0.2.10/32 —
# ТОЛЬКО адрес(а) вашего reverse-proxy, как их видит контейнер. Пусто = никому (127.0.0.1/32):
# IP клиента = адрес TCP-соединения; за прокси тогда у всех клиентов один IP, и лимиты входа
# общие. Профилю standalone настраивать не нужно (edge-Caddy ходит на внутренний порт web).
# Не ставьте private_ranges, если порт доступен из сети: любой её хост подставит себе чужой IP.
TRUSTED_PROXIES=
# Чьему X-Forwarded-For верит api (через запятую). auto = loopback + compose-сети (контейнер web,
# который передаёт уже проверенный IP клиента). Тот же список получает uvicorn; "*" запрещён.
API_TRUSTED_PROXIES=auto

# ───────────── Свой HTTPS (профиль standalone: голый VPS) ─────────────
# docker compose --profile standalone up -d  → Caddy получит сертификат для PF_DOMAIN.
# DNS A/AAAA домена должны указывать на этот сервер, порты 80 и 443 открыты.
# Например pocket.example.com (домен из PUBLIC_URL). Пусто — профиль standalone не запустится.
PF_DOMAIN=
# E-mail для Let's Encrypt (необязательно, но желательно — уведомления об истечении).
ACME_EMAIL=
EDGE_BIND=0.0.0.0
EDGE_HTTP_PORT=80
EDGE_HTTPS_PORT=443

# ───────────── PostgreSQL (сервис db) ─────────────
POSTGRES_DB=pocket
POSTGRES_USER=pocket
# Только символы [A-Za-z0-9_-] (пароль подставляется в DATABASE_URL). gen-secrets.sh сгенерирует.
POSTGRES_PASSWORD=
# Своя внешняя БД вместо сервиса db (обычно не нужно; по умолчанию собирается из POSTGRES_*):
# DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/pocket
DB_POOL_SIZE=10
# Миграции (alembic upgrade head) при старте api. false — запускать вручную (см. UPDATE.md, «Откат»).
MIGRATE_ON_START=true

# ───────────── Секреты приложения ─────────────
# HMAC токенов сессий/устройств, ≥ 32 символа. Смена = все входы и устройства сбрасываются.
SECRET_KEY=
# Общий токен бот → API (≥ 24 символа).
BOT_SERVICE_TOKEN=

# ───────────── Вход ─────────────
COOKIE_SECURE=true
SESSION_TTL_DAYS=90
# Passkeys / Face ID: RP ID = домен сайта без схемы и порта (пусто = домен из PUBLIC_URL).
WEBAUTHN_RP_ID=
WEBAUTHN_RP_NAME=Pocket
# Origin'ы для WebAuthn через запятую (пусто = PUBLIC_URL).
WEBAUTHN_ORIGINS=

# ───────────── AI (OpenAI-совместимый API) ─────────────
# Тексты операций и ключ уходят провайдеру, которого вы укажете. false — без AI: работает только
# встроенный правиловый парсер (тогда AI_* ниже не нужны).
AI_ENABLED=true
# Любой OpenAI-совместимый API, например https://api.openai.com/v1 или локальный Ollama
# http://host:11434/v1. При AI_ENABLED=true в prod обязательны все три.
AI_BASE_URL=
AI_API_KEY=
# Имя модели у провайдера (your-model). Сменить = поменять строку и `docker compose up -d api`.
AI_MODEL=
AI_TIMEOUT=20
AI_MAX_CONCURRENCY=4

# ───────────── Telegram-бот (long polling) ─────────────
# Токен от @BotFather (123456789:AA…). Пусто — бот выключен: контейнер bot пишет одну строку в лог
# и ждёт без перезапусков. После правки: docker compose up -d bot.
TELEGRAM_BOT_TOKEN=
# Кому бот отвечает и кому шлёт уведомления: TG user id через запятую (ваш id: узнать у
# @userinfobot). Пусто = никому.
TELEGRAM_ALLOWED_IDS=
# Имя бота без @ (your_pocket_bot): веб покажет ссылку на бота. Пусто = без ссылки.
TELEGRAM_BOT_USERNAME=
# Адрес API для бота внутри compose-сети.
BOT_API_BASE_URL=http://api:8000/api/v1
OUTBOX_POLL_SECONDS=5

# ───────────── Курсы, планировщик ─────────────
DEFAULT_TIMEZONE=Asia/Ho_Chi_Minh
COINGECKO_API_KEY=
RATES_HTTP_TIMEOUT=5
WORKER_TICK_SECONDS=30
# Необязательно: JSON с дополнительными счетами/алиасами для парсера — путь ВНУТРИ контейнера api
# (файл смонтируйте через docker-compose.override.yml). Формат:
# {"accounts": [["Название", "VND" | null, "bank", ["алиас", ...]], ...]}
PARSER_LEXICON_EXTRA=

# ───────────── Web ─────────────
# База API для собранного веба (вшивается при сборке образа web). Обычно /api/v1 (тот же домен).
WEB_API_BASE_URL=/api/v1
WEB_LOG_LEVEL=INFO

# ───────────── Бэкапы (сервис backup, см. docs/BACKUP.md) ─────────────
# Каталог на хосте для дампов (daily/ weekly/ monthly/ pre-restore/). Лучше абсолютный путь.
BACKUP_DIR=./infra/var/backups
# Расписание в формате cron и часовой пояс расписания (ежедневно в 03:30 по Хошимину).
BACKUP_CRON="30 3 * * *"
BACKUP_TZ=Asia/Ho_Chi_Minh
# Сделать бэкап сразу при старте контейнера backup.
BACKUP_ON_START=false
# Ротация: последние 7 дней / 4 недели / 6 месяцев.
BACKUP_KEEP_DAILY=7
BACKUP_KEEP_WEEKLY=4
BACKUP_KEEP_MONTHLY=6
# Контейнер backup станет unhealthy, если успешного бэкапа нет дольше N часов.
BACKUP_MAX_AGE_HOURS=30
# Копия на удалённый хост (пусто = выключено): user@host:/path. Каталог должен существовать.
BACKUP_REMOTE=
# rsync (зеркало всего каталога с ротацией) или scp (только новый дамп).
BACKUP_REMOTE_METHOD=rsync
BACKUP_REMOTE_PORT=22
# rsync: удалять на удалённой стороне то, что удалила локальная ротация.
BACKUP_REMOTE_DELETE=true
# Каталог на хосте с SSH-ключом (и, желательно, known_hosts) — монтируется в /ssh только на чтение.
BACKUP_SSH_DIR=./infra/var/ssh
BACKUP_SSH_KEY_NAME=id_ed25519
# Префикс имён дампов: <префикс>_2026-10-27_033000.dump.
# BACKUP_PREFIX=pocket

# ───────────── Дополнительно (обычно не трогать) ─────────────
# Профили compose, включаемые всегда (standalone = свой HTTPS через Caddy на этом сервере).
# COMPOSE_PROFILES=standalone
# Префикс имён образов: <префикс>-backend|bot|web|backup:<PF_VERSION>.
# PF_IMAGE_PREFIX=pocket
# Базовые образы.
# POSTGRES_IMAGE=postgres:16-alpine
# CADDY_IMAGE=caddy:2
# Уровень логов edge-Caddy (профиль standalone).
# EDGE_LOG_LEVEL=INFO
# Лимиты запросов (умолчания — в app/core/security_config.py). Например, общий бакет неудачных
# входов: 20 неверных паролей в час со всех адресов вместе (см. SECURITY.md).
# RATE_LIMIT_LOGIN_PER_MINUTE=5
# RATE_LIMIT_LOGIN_FAILURES_PER_HOUR=20
# RATE_LIMIT_BAN_THRESHOLD=10
# RATE_LIMIT_BAN_WINDOW_SECONDS=900
# RATE_LIMIT_BAN_SECONDS=900
# RATE_LIMIT_PASSKEY_PER_MINUTE=20
# RATE_LIMIT_API_PER_MINUTE=300
# RATE_LIMIT_AI_PER_MINUTE=60
# RATE_LIMIT_IP_PER_MINUTE=1200
# RATE_LIMIT_KNOWN_DEVICE_FAILURES_PER_HOUR=10
# Только для диагностики сборки веба (по умолчанию "pnpm run build" = проверка типов + vite).
# WEB_BUILD_CMD=pnpm run build
