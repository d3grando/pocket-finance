    "@tanstack/react-query": "5.105.0",
    "@tanstack/react-virtual": "3.14.23",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "date-fns": "4.4.0",
    "lucide-react": "1.62.0",
    "motion": "14.6.0",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.5.0",
    "recharts": "3.10.1",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.0",
    "vaul": "1.1.2",
    "workbox-window": "7.4.1",
    "zod": "4.6.7"
